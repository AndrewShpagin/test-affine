{
  "source": {
    "type": "folder",
    "path": "local-data/frames",
    "fps": 20,
    "loop": true
  },
  "codec": {
    "keyframe_bytes": 40000,
    "keyframe_period": 5,
    "keyframe_codec": "jpeg",
    "grayscale": true,
    "strips": true,
    "homography": true,
    "mesh": true,
    "mesh_grid_x": 6,
    "mesh_grid_y": 6
  },
  "udp": {
    "host": "127.0.0.1",
    "port": 5000
  },
  "control": {
    "enabled": true,
    "bind": "0.0.0.0",
    "port": 8090,
    "codec_endpoint": "/codec.json"
  }
}
