{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake configure",
            "type": "process",
            "command": "cmake",
            "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "build keyframe_test Release",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build", "--config", "Release", "--target", "keyframe_test"],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "cmake configure",
            "problemMatcher": []
        },
        {
            "label": "build mesh_test Release",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build", "--config", "Release", "--target", "mesh_test"],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "cmake configure",
            "problemMatcher": []
        },
        {
            "label": "build affine_test Release",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build", "--config", "Release", "--target", "affine_test"],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "cmake configure",
            "problemMatcher": []
        }
    ]
}
